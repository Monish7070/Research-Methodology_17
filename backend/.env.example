# ---------------------------------------------------------------
# URBAN VISION AI - backend configuration
# Copy to backend/.env and adjust. Never commit real secrets.
# ---------------------------------------------------------------

# Security
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite for development; point at PostgreSQL in production)
DATABASE_URL=sqlite:///./data/urban_vision.db

# Trained YOLO11n weights (crack / garbage / pothole)
YOLO_WEIGHTS=../models/best.pt

# Detection
IMAGE_SIZE=640
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.10

# SSIM keyframe extraction
KEYFRAME_THRESHOLD=0.92
KEYFRAME_GAP=10
KEYFRAME_RESIZE_WIDTH=320

# LayerCAM
CAM_METHOD=layercam
CAM_OPACITY=0.45
CAM_THRESHOLD=0.12
CAM_BLUR=2.0
CAM_STYLE=classic
CAM_GAMMA=1.0
MAX_LAYERCAM_PER_JOB=6

# Uploads
MAX_UPLOAD_MB=500

# Development accounts (demo logins, see README)
SEED_DEMO_DATA=true
DEMO_PASSWORD=Urban@123

# CORS (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
